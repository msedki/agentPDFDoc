    "script_sha256": "5aacd6082b8c383744aff8f65c50e1947abe8c73e03e7e898b50ebfbafbb08b6",
    "script_source": "\"\"\"Analyse de routage légère : preflight_pdf + page_route (pypdfium2 seul, sans Docling).\n\nFixtures des splits development et contract_only du manifeste V2.1 ; jamais final.\n\"\"\"\n\nimport datetime as dt\nimport hashlib\nimport json\nimport sys\nfrom pathlib import Path\n\nROOT = Path(r\"D:\\enhacements\\agentragpdf\")\nsys.path.insert(0, str(ROOT))\n\nimport yaml  # noqa: E402\n\nfrom services.ingestion.config import IngestionConfig  # noqa: E402\nfrom services.ingestion.errors import IngestionError  # noqa: E402\nfrom services.ingestion.pipeline import page_route, routing_reason  # noqa: E402\nfrom services.ingestion.preflight import check_render_budget, preflight_pdf  # noqa: E402\n\nSPLITS = (\"development\", \"contract_only\")\n\n\ndef deciding_rule(page, settings):\n    \"\"\"Première règle de page_route satisfaite, vérifiée contre page_route.\"\"\"\n    if page[\"classification\"] == \"blank\":\n        return \"blank\", \"blank\"\n    if settings.pipeline_route != \"auto\":\n        return settings.pipeline_route, \"explicit_profile_route\"\n    if page[\"needs_ocr\"]:\n        return \"regional_ocr\", \"needs_ocr\"\n    regions = page.get(\"native_text_regions\", [])\n    midpoint = (page[\"effective_box\"][0] + page[\"effective_box\"][2]) / 2\n    left = [box for box in regions if box[2] < midpoint - 15]\n    right = [box for box in regions if box[0] > midpoint + 15]\n    if page[\"vector_path_count\"] >= 8:\n        return \"structured\", \"vector_paths>=8\"\n    if len(left) >= 3 and len(right) >= 3:\n        return \"structured\", \"two_columns\"\n    if page[\"vector_path_count\"] > 0 and page.get(\"native_text_sparse\", False):\n        return \"structured\", \"vector_paths_and_sparse_text\"\n    sizes = page.get(\"text_font_sizes\", [])\n    if sizes and max(sizes) >= min(sizes) * 1.3 and max(sizes) - min(sizes) >= 2:\n        return \"structured\", \"typography_font_size_spread (pipeline.py:35-37)\"\n    if page[\"classification\"] == \"native\":\n        return \"native\", \"simple_native_signals\"\n    return \"structured\", f\"classification_{page['classification']}\"\n\n\ndef main():\n    started = dt.datetime.now(dt.UTC)\n    profile = yaml.safe_load((ROOT / \"config/local16.yaml\").read_text(encoding=\"utf-8-sig\"))\n    settings = IngestionConfig.from_mapping(profile)\n    manifest = json.loads((ROOT / \"evals/qualification-v2.1/manifest.json\").read_text(encoding=\"utf-8\"))\n    fixtures, counts, native_pages, mismatches = [], {}, [], []\n    for entry in manifest[\"entries\"]:\n        if entry[\"split\"] not in SPLITS:\n            continue\n        path = ROOT / \"fixtures\" / entry[\"path\"]\n        record = {\"key\": entry[\"key\"], \"split\": entry[\"split\"], \"type\": entry.get(\"type\"), \"path\": entry[\"path\"],\n                  \"manifest_sha256\": entry[\"sha256\"]}\n        actual = hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else None\n        record[\"sha256_verified\"] = actual == entry[\"sha256\"]\n        if not record[\"sha256_verified\"]:\n            record[\"status\"] = \"SKIPPED_HASH_MISMATCH\"\n            fixtures.append(record)\n            continue\n        try:\n            preflight = preflight_pdf(path, settings)\n        except IngestionError as exc:\n            record.update(status=\"PREFLIGHT_REFUSED\", error_code=exc.code)\n            fixtures.append(record)\n            continue\n        record.update(status=\"ANALYZED\", page_count=preflight[\"page_count\"], pages=[])\n        for page in preflight[\"pages\"]:\n            route = page_route(page, settings)\n            rule_route, rule = deciding_rule(page, settings)\n            if rule_route != route:\n                mismatches.append({\"key\": entry[\"key\"], \"page_index\": page[\"page_index\"], \"page_route\": route, \"rule_route\": rule_route})\n            try:\n                check_render_budget(page, route, settings)\n                budget = \"OK\"\n            except IngestionError as exc:\n                budget = exc.code\n            sizes = page.get(\"text_font_sizes\", [])\n            record[\"pages\"].append({\"page_index\": page[\"page_index\"], \"classification\": page[\"classification\"],\n                                    \"needs_ocr\": page[\"needs_ocr\"], \"vector_path_count\": page[\"vector_path_count\"],\n                                    \"native_text_sparse\": page[\"native_text_sparse\"],\n                                    \"font_size_min\": min(sizes) if sizes else None, \"font_size_max\": max(sizes) if sizes else None,\n                                    \"image_regions\": len(page[\"image_regions\"]), \"rotation\": page[\"rotation\"],\n                                    \"route\": route, \"routing_reason\": routing_reason(page, route, settings),\n                                    \"deciding_rule\": rule, \"render_budget\": budget})\n            counts[route] = counts.get(route, 0) + 1\n            if route == \"native\":\n                native_pages.append({\"key\": entry[\"key\"], \"page_index\": page[\"page_index\"]})\n        fixtures.append(record)\n    typography = sum(page[\"deciding_rule\"].startswith(\"typography\") for fixture in fixtures for page in fixture.get(\"pages\", []))\n    source = Path(__file__).read_bytes()\n    report = {\"analysis\": \"routing-preflight\", \"started_utc\": started.isoformat(), \"finished_utc\": dt.datetime.now(dt.UTC).isoformat(),\n              \"scope\": \"preflight_pdf + page_route + check_render_budget (pypdfium2) ; aucun Docling, OCR ni modèle ; split final exclu.\",\n              \"profile\": \"config/local16.yaml\", \"pipeline_route\": settings.pipeline_route,\n              \"splits\": list(SPLITS), \"fixtures_total\": len(fixtures),\n              \"route_page_counts\": counts, \"auto_native_reached\": bool(native_pages), \"auto_native_pages\": native_pages,\n              \"typography_rule_pages\": typography, \"rule_trace_mismatches\": mismatches,\n              \"hypothesis_pipeline_35_37\": (\"CONFIRMEE : aucune page n'atteint la voie auto->native\" if not native_pages\n                                            else \"INFIRMEE : au moins une page atteint la voie auto->native\"),\n              \"generator\": {\"script_sha256\": hashlib.sha256(source).hexdigest(), \"script_source\": source.decode(\"utf-8\")},\n              \"fixtures\": fixtures}\n    target_dir = ROOT / \"RAG_Local_Agents/reports/ingestion\"\n    target_dir.mkdir(parents=True, exist_ok=True)\n    target = target_dir / f\"routing-preflight-{started.strftime('%Y%m%dT%H%M%SZ')}.json\"\n    with target.open(\"x\", encoding=\"utf-8\", newline=\"\\n\") as stream:\n        stream.write(json.dumps(report, ensure_ascii=False, indent=2) + \"\\n\")\n    print(json.dumps({\"report\": target.relative_to(ROOT).as_posix(), \"route_page_counts\": counts,\n                      \"auto_native_reached\": bool(native_pages), \"typography_rule_pages\": typography,\n                      \"mismatches\": len(mismatches)}, ensure_ascii=False))\n\n\nif __name__ == \"__main__\":\n    main()\n"
  },
